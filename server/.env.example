# ==============================================================
# MERN Grievance Redressal System (GRS) - Environment Configuration
# ==============================================================

# Core Database and Server Configuration
MONGO_URI=mongodb://localhost:27017/grs
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# ==============================================================
# AI Provider Configuration (Choose one or leave blank for Rule-Based Fallback)
# ==============================================================

# AI Provider: 'gemini' | 'openai' | 'rule-based' | 'auto'
# Defaults to 'auto' (detects available key, falls back to rule-based engine if missing)
AI_PROVIDER=auto

# Option A: Google Gemini Configuration
# Obtain your free API key at: https://aistudio.google.com/
AI_API_KEY=
# or
GEMINI_API_KEY=
# Model options: gemini-1.5-flash | gemini-2.0-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Option B: OpenAI / Groq / OpenRouter / DeepSeek Configuration
# OPENAI_API_KEY=your_openai_or_groq_api_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo

# NOTE: If AI_API_KEY is left blank, the application automatically uses the
# high-precision heuristic rule-based classifier and chatbot fallback.
# Zero external setup is needed to start running immediately!
